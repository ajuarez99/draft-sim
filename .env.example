# Copy to .env and fill in for a real deployment. None of this is needed to run
# locally -- every value below has a working local default baked into
# application.yml, so `./gradlew bootRun` works with no environment at all.

# --- database ---------------------------------------------------------------
# Local default: jdbc:postgresql://localhost:5433/draftsim
DB_URL=jdbc:postgresql://your-host:5432/draftsim
DB_USER=draftsim
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# --- api auth ---------------------------------------------------------------
# Blank or unset = auth DISABLED (local default). Any non-empty value turns on
# the bearer check for every /api/** route except /api/health.
# Generate one with:  openssl rand -base64 48
API_TOKEN=

# --- app owner ----------------------------------------------------------------
# A FALLBACK, not the identity -- claude/user-identity-and-onboarding.md. Once
# someone signs in through the app (typing a Sleeper username at "/"), their
# id travels on every request as the X-Sleeper-User header and OwnerSlot
# resolves their own seat from that. This variable only matters for a request
# with no header at all: blank/unset = slot auto-detection DISABLED, the draft
# view falls back to the manual slot input. Set to your own Sleeper user id (a
# numeric string, e.g. "1122386008709910528") to keep the old single-user
# behavior on a deploy nobody else has signed into yet.
APP_OWNER_SLEEPER_USER_ID=

# --- cors -------------------------------------------------------------------
# Comma separated. Must include the deployed frontend's exact origin.
# Local default: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=https://draft-sim.vercel.app

# --- misc -------------------------------------------------------------------
# Most platforms inject PORT themselves; leave unset unless yours doesn't.
# PORT=8080
# The Docker image sets this to /app/config/weights.yml already.
# WEIGHTS_FILE=../config/weights.yml
LOG_LEVEL=INFO
