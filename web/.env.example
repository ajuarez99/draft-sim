# Copy to .env and fill in for a real deployment. Neither value is needed to run
# locally -- both default to "same origin, no auth header", which is exactly
# what `npm run dev` against Vite's own proxy needs.

# --- api location -------------------------------------------------------------
# Blank (local default) = every /api/... call stays a same-origin relative
# path. Set this only when the frontend and backend are on different origins
# (DEPLOY.md: Vercel frontend + Fly/Railway backend) -- the deployed backend's
# own origin, no trailing slash.
VITE_API_BASE=https://your-backend.fly.dev

# --- api auth -------------------------------------------------------------
# Blank (local default) = no Authorization header sent, matching the
# backend's own API_TOKEN-unset default. Set this to the same value as the
# backend's API_TOKEN once that's turned on.
#
# This ships to every browser that loads the page and is readable in devtools
# -- fine for a private tool only you use, not fine for a link you hand out.
# See DEPLOY.md.
#
# Does NOT cover useLiveDraft.ts's EventSource -- the browser has no way to
# attach a header to it, so live mode against a token-protected, split-origin
# backend needs its own fix first.
VITE_API_TOKEN=
