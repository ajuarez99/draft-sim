# Deployed as its own Railway service with Root Directory = web, so this
# build context is web/ itself (no web/ prefix on COPY paths).

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Vite inlines VITE_* vars at build time, so this has to be a build arg, not a
# runtime env var -- set it as a Railway "build variable" pointing at the
# backend service's public URL, e.g. https://api.ballknowers.co
ARG VITE_API_BASE
ENV VITE_API_BASE=$VITE_API_BASE
# Spec 052: Umami Cloud website id, a build variable like the one above. Optional --
# absent means analytics is off (no tracker script is added to the page).
ARG VITE_UMAMI_WEBSITE_ID
ENV VITE_UMAMI_WEBSITE_ID=$VITE_UMAMI_WEBSITE_ID
# Spec 073: which site this service builds, and where each site lives. All three are build
# variables like the ones above (Vite inlines them). VITE_SITE is "timemachine", "leagues", or unset
# for the combined single site; any other value FAILS the build on purpose. The two origins default to
# https://www.ballknowers.co and https://leagues.ballknowers.co. DEPLOY.md "Two sites".
ARG VITE_SITE
ENV VITE_SITE=$VITE_SITE
ARG VITE_TM_ORIGIN
ENV VITE_TM_ORIGIN=$VITE_TM_ORIGIN
ARG VITE_LEAGUES_ORIGIN
ENV VITE_LEAGUES_ORIGIN=$VITE_LEAGUES_ORIGIN
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
# Spec 079: the web server is server/server.mjs, built on the two libraries `serve@14.2.6` itself runs (serve-handler 6.1.7 and
# compression 1.8.1; the same exact versions are pinned in package.json). Installing just these two (not `npm ci`, which would
# pull React and Vite into the runtime image) keeps the image small; the pins here and in package.json must move together.
RUN npm install --no-save serve-handler@6.1.7 compression@1.8.1
COPY --from=build /app/dist ./dist
COPY server ./server
# Spec 074: the serve config is GENERATED by the build (vite.config.ts writes it beside dist, per VITE_SITE),
# not copied from the repo. It carries web/serve.json's security headers (see DEPLOY.md "Security headers")
# plus this site's routing: the Time Machine site serves its static pages as files, answers every other
# unknown path with a real 404, and rewrites only the app-only paths to app-shell.html; the league and
# combined sites keep what `serve -s` did (every path answers index.html). It lives outside dist/ so it is
# not itself published.
COPY --from=build /app/serve.site.json ./serve.site.json
# Spec 079: which site this is and where the backend lives (VITE_API_BASE), also generated by the build. The server reads it to
# decide whether to answer /game/<id> with that game's share-preview tags (Time Machine site only) and where to fetch them.
COPY --from=build /app/server.site.json ./server.site.json
# Railway assigns PORT at runtime; the server reads it (default 3000). It resolves ../dist, ../serve.site.json and
# ../server.site.json relative to server/server.mjs.
CMD ["node", "server/server.mjs"]
